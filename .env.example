# MenuAI server configuration (Phase 2). Copy to .env and fill in. NEVER commit .env.
# The browser-only editor (Phase 1) needs none of this.

# Public HTTPS address of your MenuAI site (used in login links and menu URLs).
# Must match exactly what users open in the browser (scheme, domain, port, no path):
# requests from any other origin are rejected (CSRF protection).
PUBLIC_URL=https://menu.example.com

# Database password — generate one, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=

# Email for login links (any SMTP provider). Leave empty until you choose one:
# the owner can still sign in with a one-time link printed by the CLI.
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="MenuAI <menu@example.com>"

LOG_LEVEL=info

# Total storage for uploaded images (MB). Every upload is virus scanned by the clamav service
# in docker-compose.yml (CLAMAV_URL is set there); without a scanner, uploads are disabled.
UPLOAD_QUOTA_MB=2048

# Pay at the table (docs/PAYMENTS.md). 32 random bytes, base64: openssl rand -base64 32
# Encrypts the payment company's account details in the database. Without it, payments are off.
# Keep a copy in a password manager: backups do not include this file, and without the key the
# owner has to re-enter the payment company details after a restore.
PAYMENTS_KEY=

# Payment companies allowed in live mode, comma-separated (grow, payplus). Add one only after its
# sandbox run in docs/PAYMENTS.md has passed. Empty = test mode only.
PAYMENTS_LIVE_PROVIDERS=

# Payment reports group by this time zone's calendar days.
BUSINESS_TIMEZONE=Asia/Jerusalem
