{
  "name": "menuai",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source multilingual, designer-grade, responsive menu builder.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "check:attribution": "node scripts/check-attribution.mjs",
    "test:watch": "vitest",
    "test:server": "vitest run --config server/vitest.config.ts",
    "server:dev": "node scripts/build-server.mjs --watch",
    "server:build": "node scripts/build-server.mjs",
    "server:start": "node --enable-source-maps dist-server/main.mjs",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "@fontsource/suez-one": "^5.3.0",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
